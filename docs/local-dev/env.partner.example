# Copy to remcard-partner-platform/.env.local (never commit)

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
REMCARD_API_BASE_URL=http://127.0.0.1:3001
REMCARD_API_BASIC_USER=CHANGE_ME
REMCARD_API_BASIC_PASSWORD=CHANGE_ME

# Optional: override bot/legal links shown on login (defaults match production)
# NEXT_PUBLIC_TELEGRAM_BOT_LOGIN_URL=https://t.me/RemCardBot?start=login
# NEXT_PUBLIC_REMCARD_SITE_URL=https://remcard.ru
