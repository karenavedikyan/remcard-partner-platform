# Public URL of this partner cabinet (local dev or future pro.remcard.ru)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Optional: public RemCard origin for client certificate links (e.g. https://remcard.ru).
# If unset, UI uses certificateUrl from the backend response.
NEXT_PUBLIC_CERTIFICATE_BASE_URL=

# Yandex Maps JS API (client-side branch address confirm in profile). Build-time for Next.js:
# set on the platform host (e.g. prof.remcard.ru), restrict HTTP Referer to that origin, rebuild.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Allowed test backend base URL (no trailing slash, no credentials in URL).
# Leave empty in M1 until a local or staging backend is available.
REMCARD_API_BASE_URL=

# Optional upstream Basic Auth for a protected test backend (server-only).
# Both variables are required together; do not put credentials in REMCARD_API_BASE_URL.
REMCARD_API_BASIC_USER=
REMCARD_API_BASIC_PASSWORD=
