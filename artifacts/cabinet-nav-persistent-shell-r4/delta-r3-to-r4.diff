+  CabinetShellTemplateReconciler: ({
+    freshShellContextToken,
+    children,
+  }: {
+    freshShellContextToken: string;
+    children: React.ReactNode;
+  }) => (
+    <div data-testid="reconciler" data-token={freshShellContextToken}>
