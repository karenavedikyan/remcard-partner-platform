diff --git a/src/components/layout/cabinet-shell-context-remount.test.tsx b/src/components/layout/cabinet-shell-context-remount.test.tsx
new file mode 100644
index 00000000..24ac17ba
--- /dev/null
+++ b/src/components/layout/cabinet-shell-context-remount.test.tsx
@@ -0,0 +1,159 @@
+import { describe, expect, it, vi } from "vitest";
+import { render, screen } from "@testing-library/react";
+import { CookieConsentProvider } from "@/contexts/CookieConsentContext";
+import { ThemeProvider } from "@/contexts/ThemeContext";
+import { AppShell } from "@/components/layout/AppShell";
+import { AgentAppShell } from "@/components/layout/agent/AgentAppShell";
+import { CabinetShellContextProvider } from "@/components/layout/cabinet-shell-context";
+import type { CabinetUiPreferencesResponse } from "@/lib/cabinet-ui-preferences-types";
+
+const pathnameState = vi.hoisted(() => ({ value: "/" }));
+
+vi.mock("@/lib/prof-admin-management-api", () => ({
+  recordProfSessionVisit: vi.fn().mockResolvedValue({ ok: true, recorded: false }),
+  fetchManagementOverview: vi.fn(),
+}));
+
+vi.mock("@/lib/api-client", () => ({
+  remcardFetch: vi.fn().mockResolvedValue({ partnerships: [] }),
+  RemcardApiError: class RemcardApiError extends Error {
+    status: number;
+    constructor(status: number, message: string) {
+      super(message);
+      this.status = status;
+    }
+  },
+}));
+
+vi.mock("next/navigation", () => ({
+  usePathname: () => pathnameState.value,
+  useSearchParams: () => new URLSearchParams(""),
+  useRouter: () => ({ push: vi.fn(), refresh: vi.fn() }),
+}));
+
+vi.mock("@/components/account-session/AccountSessionMenu", () => ({
+  AccountSessionMenu: () => <div data-testid="account-session-menu-fixture" />,
+}));
+
+const agentPrefs: CabinetUiPreferencesResponse = {
+  contractVersion: "2026-10-14.r01",
+  pilotEnabled: true,
+  pilotActive: true,
+  contextKey: "ctx-1",
+  version: 1,
+  theme: "system",
+  mobileNavKeys: ["home"],
+  permittedKeys: ["home", "clients"],
+  defaultMobileNavKeys: null,
+};
+
+describe("cabinet shell context token remount", () => {
+  it("remounts legacy AppShell when identity token changes", () => {
+    pathnameState.value = "/";
+    const { rerender } = render(
+      <ThemeProvider>
+        <CookieConsentProvider>
+          <CabinetShellContextProvider shellContextToken="token-user-a">
+            <AppShell
+              key="token-user-a"
+              user={{ id: "user-a", displayName: "User A", role: "PRO" }}
+            >
+              <div data-testid="page-content">content</div>
+            </AppShell>
+          </CabinetShellContextProvider>
+        </CookieConsentProvider>
+      </ThemeProvider>,
+    );
+    const sidebarBefore = screen.getByLabelText("Основная навигация");
+
+    rerender(
+      <ThemeProvider>
+        <CookieConsentProvider>
+          <CabinetShellContextProvider shellContextToken="token-user-b">
+            <AppShell
+              key="token-user-b"
+              user={{ id: "user-b", displayName: "User B", role: "PRO" }}
+            >
+              <div data-testid="page-content">content</div>
+            </AppShell>
+          </CabinetShellContextProvider>
+        </CookieConsentProvider>
+      </ThemeProvider>,
+    );
+
+    const sidebarAfter = screen.getByLabelText("Основная навигация");
+    expect(sidebarBefore).not.toBe(sidebarAfter);
+  });
+
+  it("remounts legacy AppShell on branch token change for same user id", () => {
+    const { rerender } = render(
+      <ThemeProvider>
+        <CookieConsentProvider>
+          <CabinetShellContextProvider shellContextToken="token-branch-a">
+            <AppShell
+              key="token-branch-a"
+              user={{ id: "user-1", displayName: "Same", role: "PRO" }}
+            >
+              <div>content</div>
+            </AppShell>
+          </CabinetShellContextProvider>
+        </CookieConsentProvider>
+      </ThemeProvider>,
+    );
+    const sidebarBefore = screen.getByLabelText("Основная навигация");
+
+    rerender(
+      <ThemeProvider>
+        <CookieConsentProvider>
+          <CabinetShellContextProvider shellContextToken="token-branch-b">
+            <AppShell
+              key="token-branch-b"
+              user={{ id: "user-1", displayName: "Same", role: "PRO" }}
+            >
+              <div>content</div>
+            </AppShell>
+          </CabinetShellContextProvider>
+        </CookieConsentProvider>
+      </ThemeProvider>,
+    );
+
+    expect(sidebarBefore).not.toBe(screen.getByLabelText("Основная навигация"));
+  });
+
+  it("remounts AgentAppShell when shell context token changes", () => {
+    const { rerender } = render(
+      <ThemeProvider>
+        <CookieConsentProvider>
+          <CabinetShellContextProvider shellContextToken="ctx-a">
+            <AgentAppShell
+              key="ctx-a:ctx-1:user-1"
+              user={{ id: "user-1", displayName: "Agent", role: "PRO" }}
+              initialPrefs={agentPrefs}
+            >
+              <div data-testid="agent-page">agent</div>
+            </AgentAppShell>
+          </CabinetShellContextProvider>
+        </CookieConsentProvider>
+      </ThemeProvider>,
+    );
+    const navBefore = screen.getByLabelText("Основная навигация");
+
+    rerender(
+      <ThemeProvider>
+        <CookieConsentProvider>
+          <CabinetShellContextProvider shellContextToken="ctx-b">
+            <AgentAppShell
+              key="ctx-b:ctx-1:user-1"
+              user={{ id: "user-1", displayName: "Agent", role: "PRO" }}
+              initialPrefs={agentPrefs}
+            >
+              <div data-testid="agent-page">agent</div>
+            </AgentAppShell>
+          </CabinetShellContextProvider>
+        </CookieConsentProvider>
+      </ThemeProvider>,
+    );
+
+    expect(navBefore).not.toBe(screen.getByLabelText("Основная навигация"));
+  });
+});
diff --git a/src/hooks/useAgentCabinetPrefsPathRefresh.test.tsx b/src/hooks/useAgentCabinetPrefsPathRefresh.test.tsx
new file mode 100644
index 00000000..5eea7e35
--- /dev/null
+++ b/src/hooks/useAgentCabinetPrefsPathRefresh.test.tsx
@@ -0,0 +1,66 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { renderHook, waitFor } from "@testing-library/react";
+import { RemcardApiError } from "@/lib/api-client";
+import { neutralCabinetUiPreferencesFallback } from "@/lib/cabinet-ui-preferences-fallback";
+import type { CabinetUiPreferencesResponse } from "@/lib/cabinet-ui-preferences-types";
+
+const mocks = vi.hoisted(() => ({
+  remcardFetch: vi.fn(),
+  pathname: "/",
+  refresh: vi.fn(),
+}));
+
+vi.mock("@/lib/api-client", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("@/lib/api-client")>();
+  return {
+    ...actual,
+    remcardFetch: mocks.remcardFetch,
+  };
+});
+
+vi.mock("next/navigation", () => ({
+  usePathname: () => mocks.pathname,
+  useRouter: () => ({ refresh: mocks.refresh, push: vi.fn() }),
+}));
+
+import { useAgentCabinetPrefsPathRefresh } from "@/hooks/useAgentCabinetPrefsPathRefresh";
+import { useAgentCabinetUiPrefs } from "@/components/layout/agent/useAgentCabinetUiPrefs";
+
+const v3: CabinetUiPreferencesResponse = {
+  contractVersion: "2026-10-14.r01",
+  pilotEnabled: true,
+  pilotActive: true,
+  contextKey: "ctx",
+  version: 3,
+  theme: "system",
+  mobileNavKeys: ["home"],
+  permittedKeys: ["home"],
+  defaultMobileNavKeys: null,
+};
+
+function PrefsPathRefreshProbe() {
+  const { applyServerPrefs, applyAuthFailureClear, getApplyGeneration, prefs } =
+    useAgentCabinetUiPrefs(v3);
+  useAgentCabinetPrefsPathRefresh(
+    applyServerPrefs,
+    applyAuthFailureClear,
+    getApplyGeneration,
+  );
+  return prefs;
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.pathname = "/";
+});
+
+describe("useAgentCabinetPrefsPathRefresh auth failure", () => {
+  it.each([401, 403])("clears prefs to neutral on HTTP %i", async (status) => {
+    mocks.remcardFetch.mockRejectedValue(new RemcardApiError(status, "denied", null));
+    const { result } = renderHook(() => PrefsPathRefreshProbe());
+    await waitFor(() =>
+      expect(result.current).toEqual(neutralCabinetUiPreferencesFallback),
+    );
+    expect(mocks.refresh).toHaveBeenCalled();
+  });
+});
