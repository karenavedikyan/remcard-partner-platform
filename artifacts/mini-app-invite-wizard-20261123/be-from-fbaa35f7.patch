+import { NextRequest, NextResponse } from 'next/server';
+import { miniAppApiDynamic } from '@/lib/miniAppRouteSegment';
+import {
+  buildMiniAppPartnershipInviteContext,
+  guardMiniAppPartnershipRoute,
+  privateNoStore,
+} from '@/lib/miniAppPartnershipInviteRoute';
+
+export const dynamic = miniAppApiDynamic.dynamic;
+export const fetchCache = miniAppApiDynamic.fetchCache;
+export const revalidate = miniAppApiDynamic.revalidate;
+
+export async function GET(req: NextRequest) {
+  const guard = await guardMiniAppPartnershipRoute(req);
+  if (!guard.ok) return guard.response;
+
+  const ctx = await buildMiniAppPartnershipInviteContext(guard.user, guard.role, req);
+  if (!ctx.ok) {
+    return privateNoStore(NextResponse.json({ error: ctx.error, code: ctx.code }, { status: ctx.status }));
+  }
+
+  return privateNoStore(
+    NextResponse.json({
+      kind: ctx.kind,
+      nameMaxLength: ctx.nameMaxLength,
+      noteMaxLength: ctx.noteMaxLength,
+      inviterBusinessSide: ctx.inviterBusinessSide,
+      categoryPlan: ctx.categoryPlan,
+    }),
+  );
+}
