@@ -0,0 +1,82 @@
+import { UserRole } from '@prisma/client';
+import { NextRequest, NextResponse } from 'next/server';
+import { createPartnershipLinkInvite } from '@/lib/partnershipLinkInvite';
+import { partnershipLinkJsonResponse } from '@/lib/partnershipLinkInviteHttp';
+import { parseLinkInvitePartnerType } from '@/lib/partnershipLinkInviteRecipient';
+import {
+  inviterBusinessSideSnapshot,
+  resolvePartnershipManageContext,
+} from '@/lib/employeeWorkspace/partnershipRouteAuth';
+import { logPartnershipDelegatedAction } from '@/lib/employeeWorkspace/partnershipDelegatedAudit';
+import { miniAppApiDynamic } from '@/lib/miniAppRouteSegment';
+import { guardMiniAppPartnershipRoute, privateNoStore } from '@/lib/miniAppPartnershipInviteRoute';
+
+export const dynamic = miniAppApiDynamic.dynamic;
+export const fetchCache = miniAppApiDynamic.fetchCache;
+export const revalidate = miniAppApiDynamic.revalidate;
+
+function jsonFromPartnershipResponse(res: Response): NextResponse {
+  return privateNoStore(new NextResponse(res.body, { status: res.status, headers: res.headers }));
+}
+
+export async function POST(req: NextRequest) {
+  const guard = await guardMiniAppPartnershipRoute(req);
+  if (!guard.ok) return guard.response;
+
+  if (guard.role === 'agent') {
+    return privateNoStore(
+      NextResponse.json(
+        { error: 'Для агента используйте приглашение к обсуждению', code: 'WRONG_INVITE_KIND' },
+        { status: 403 },
+      ),
+    );
+  }
+
+  const manage = await resolvePartnershipManageContext(
+    { id: guard.user.id, role: UserRole.PRO, isProfTestUser: guard.user.isProfTestUser },
+    req,
+  );
+  if (!manage.ok) {
+    return jsonFromPartnershipResponse(partnershipLinkJsonResponse({ error: manage.error }, { status: manage.status }));
+  }
+
+  const body = await req.json().catch(() => ({}));
+  const terms = Array.isArray(body.terms) ? body.terms : [];
+  const note = body.note != null ? String(body.note) : null;
+  const intendedPartnerType = parseLinkInvitePartnerType(body.intendedPartnerType);
+  if (body.intendedPartnerType != null && !intendedPartnerType) {
+    return jsonFromPartnershipResponse(
+      partnershipLinkJsonResponse({ error: 'Неизвестный тип партнёра' }, { status: 400 }),
+    );
+  }
+
+  const result = await createPartnershipLinkInvite({
+    inviterId: manage.principalUserId,
+    createdByUserId: manage.actorUserId,
+    intendedPartnerType,
+    terms,
+    note,
+    recipientLabel: body.recipientLabel,
+  });
+
+  if (!result.ok) {
+    return jsonFromPartnershipResponse(partnershipLinkJsonResponse({ error: result.error }, { status: result.status }));
+  }
+
+  await logPartnershipDelegatedAction({
+    actorUserId: manage.actorUserId,
+    principalUserId: manage.principalUserId,
+    op: 'link_invite_create',
+    entityId: result.inviteId,
+  });
+
+  return jsonFromPartnershipResponse(
+    partnershipLinkJsonResponse({
+      inviteId: result.inviteId,
+      token: result.token,
+      expiresAt: result.expiresAt.toISOString(),
+      previewPath: result.previewPath,
+      inviterBusinessSide: inviterBusinessSideSnapshot(manage.principal),
+    }),
+  );
+}
