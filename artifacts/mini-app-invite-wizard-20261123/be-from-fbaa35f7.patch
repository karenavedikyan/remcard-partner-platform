+import { NextRequest, NextResponse } from 'next/server';
+import { createPartnershipDiscussionInvite } from '@/lib/partnershipDiscussionInvite';
+import { miniAppApiDynamic } from '@/lib/miniAppRouteSegment';
+import {
+  guardMiniAppDiscussionCreate,
+  guardMiniAppPartnershipRoute,
+  privateNoStore,
+} from '@/lib/miniAppPartnershipInviteRoute';
+
+export const dynamic = miniAppApiDynamic.dynamic;
+export const fetchCache = miniAppApiDynamic.fetchCache;
+export const revalidate = miniAppApiDynamic.revalidate;
+
+export async function POST(req: NextRequest) {
+  const guard = await guardMiniAppPartnershipRoute(req);
+  if (!guard.ok) return guard.response;
+
+  if (guard.role !== 'agent') {
+    return privateNoStore(
+      NextResponse.json(
+        { error: 'Для этого профиля используйте приглашение с условиями', code: 'WRONG_INVITE_KIND' },
+        { status: 403 },
+      ),
+    );
+  }
+
+  const discussion = await guardMiniAppDiscussionCreate(guard.user, req);
+  if (!discussion.ok) {
+    return privateNoStore(NextResponse.json({ error: discussion.error }, { status: discussion.status }));
+  }
+
+  const body = await req.json().catch(() => ({}));
+  const result = await createPartnershipDiscussionInvite({
+    inviterId: guard.user.id,
+    recipientLabel: body.recipientLabel,
+    cooperationSubject: body.cooperationSubject,
+  });
+
+  if (!result.ok) {
+    return privateNoStore(NextResponse.json({ error: result.error }, { status: result.status }));
+  }
+
+  return privateNoStore(
+    NextResponse.json({
+      inviteId: result.inviteId,
+      token: result.token,
+      expiresAt: result.expiresAt.toISOString(),
+      previewPath: result.previewPath,
+    }),
+  );
+}
