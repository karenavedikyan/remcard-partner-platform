@@ -0,0 +1,251 @@
+import { CatalogStatus, PartnerType, UserRole, type User } from '@prisma/client';
+import { NextResponse, type NextRequest } from 'next/server';
+import { apiError } from '@/lib/api/error';
+import { getProContextForRequest } from '@/lib/proContextRequest';
+import { isProfMiniAppEnabled, isProfMiniAppPilotOpenForUser } from '@/lib/profMiniAppConfig';
+import { assertMiniAppAccess } from '@/lib/miniAppSessionCookie';
+import { getProfCabinetUserForMiniApp } from '@/lib/miniAppCabinetAuth';
+import { resolveMiniAppRoleForUser, type MiniAppRole } from '@/lib/miniAppBootstrap';
+import {
+  inviterBusinessSideSnapshot,
+  resolvePartnershipManageContext,
+} from '@/lib/employeeWorkspace/partnershipRouteAuth';
+import {
+  categoriesForLinkInviteCreate,
+  GENERAL_PARTNERSHIP_CATEGORY,
+  userIsStoreOwner,
+} from '@/lib/partnershipLinkInviteShared';
+import {
+  assertIndependentDiscussionActor,
+  DISCUSSION_RECIPIENT_LABEL_MAX,
+  DISCUSSION_SUBJECT_MAX,
+} from '@/lib/partnershipDiscussionInvite';
+import { LINK_INVITE_RECIPIENT_LABEL_MAX } from '@/lib/partnershipLinkInviteAuthorLabels';
+import { parseLinkInvitePartnerType } from '@/lib/partnershipLinkInviteRecipient';
+import { resolvePartnershipAccessMode } from '@/lib/profTestPartnershipScope';
+import type { ProContextSerialized } from '@/lib/proBranchContext';
+import { shouldPreferOrgWorkplaceContext } from '@/lib/employeeWorkspace/workplaceContext';
+import { prisma } from '@/lib/prisma';
+
+export const MINI_APP_LINK_INVITE_NOTE_MAX = 400;
+
+export type MiniAppPartnershipInviteKind = 'discussion' | 'terms';
+
+export type MiniAppPartnershipInviteContext =
+  | {
+      ok: true;
+      kind: MiniAppPartnershipInviteKind;
+      nameMaxLength: number;
+      noteMaxLength: number;
+      inviterBusinessSide: ReturnType<typeof inviterBusinessSideSnapshot> | null;
+      categoryPlan: { categories: string[]; requiresIntendedType: boolean; error?: string };
+    }
+  | { ok: false; status: number; error: string; code?: string };
+
+function parseHostPlatform(raw: string | null): 'telegram' | 'max' | null {
+  const v = raw?.trim().toLowerCase();
+  if (v === 'telegram' || v === 'tg') return 'telegram';
+  if (v === 'max') return 'max';
+  return null;
+}
+
+export function partnershipManageActor(user: User) {
+  return {
+    id: user.id,
+    role: user.role,
+    isProfTestUser: user.isProfTestUser,
+  };
+}
+
+export function privateNoStore(res: NextResponse): NextResponse {
+  res.headers.set('Cache-Control', 'private, no-store');
+  return res;
+}
+
+export type MiniAppPartnershipRouteGuard =
+  | {
+      ok: true;
+      platform: 'telegram' | 'max';
+      user: User;
+      role: MiniAppRole;
+      proCtx: Awaited<ReturnType<typeof getProContextForRequest>>;
+    }
+  | { ok: false; response: NextResponse };
+
+/** Invite routes only: allows org staff (UserRole.CLIENT) with partnership manage into terms flow. */
+export async function resolveMiniAppPartnershipInviteRole(
+  user: User,
+  proCtx: ProContextSerialized,
+  req: NextRequest,
+): Promise<MiniAppRole | null> {
+  const direct = await resolveMiniAppRoleForUser(user.id, proCtx);
+  if (direct) return direct;
+
+  if (user.role !== UserRole.CLIENT) return null;
+  if (!shouldPreferOrgWorkplaceContext(proCtx)) return null;
+
+  const manage = await resolvePartnershipManageContext(partnershipManageActor(user), req);
+  if (!manage.ok) return null;
+
+  const orgType = proCtx.organization?.partnerType;
+  if (orgType === PartnerType.STORE) return 'store';
+  if (orgType === PartnerType.COMPANY) return 'company';
+  return null;
+}
+
+export async function guardMiniAppPartnershipRoute(req: NextRequest): Promise<MiniAppPartnershipRouteGuard> {
+  if (!isProfMiniAppEnabled()) {
+    return { ok: false, response: apiError('NOT_FOUND') };
+  }
+
+  const platform =
+    parseHostPlatform(req.headers.get('x-remcard-mini-app-platform')) ??
+    parseHostPlatform(req.nextUrl.searchParams.get('host'));
+  if (!platform) {
+    return { ok: false, response: apiError('BAD_REQUEST', 'Укажите платформу хоста') };
+  }
+
+  const user = await getProfCabinetUserForMiniApp(req, platform);
+  if (!user) {
+    return { ok: false, response: apiError('UNAUTHORIZED') };
+  }
+  if (!isProfMiniAppPilotOpenForUser({ userId: user.id, publicId: user.publicId })) {
+    return { ok: false, response: apiError('NOT_FOUND') };
+  }
+
+  const sessionGuard = await assertMiniAppAccess(req, platform, user.id);
+  if (!sessionGuard.ok) {
+    return {
+      ok: false,
+      response: privateNoStore(
+        new NextResponse(
+          JSON.stringify({ error: sessionGuard.message, code: sessionGuard.code }),
+          { status: sessionGuard.status, headers: { 'Content-Type': 'application/json' } },
+        ),
+      ),
+    };
+  }
+
+  const proCtx = await getProContextForRequest(req, user.id);
+  const role = await resolveMiniAppPartnershipInviteRole(user, proCtx, req);
+  if (!role) {
+    return {
+      ok: false,
+      response: privateNoStore(
+        new NextResponse(
+          JSON.stringify({
+            error: 'Мини-кабинет недоступен для этого аккаунта',
+            code: 'ROLE_UNSUPPORTED',
+          }),
+          { status: 403, headers: { 'Content-Type': 'application/json' } },
+        ),
+      ),
+    };
+  }
+
+  return { ok: true, platform, user, role, proCtx };
+}
+
+export async function guardMiniAppDiscussionCreate(
+  user: User,
+  req: NextRequest,
+): Promise<{ ok: true } | { ok: false; status: number; error: string }> {
+  if (user.role !== UserRole.PRO) {
+    return { ok: false, status: 403, error: 'Доступно только партнёрам' };
+  }
+  const accessMode = await resolvePartnershipAccessMode(req, user);
+  if (accessMode === 'deny') {
+    return { ok: false, status: 401, error: 'Не авторизован' };
+  }
+  return assertIndependentDiscussionActor(user.id, 'create');
+}
+
+async function principalCatalogStatus(principalUserId: string): Promise<CatalogStatus> {
+  const row = await prisma.user.findUnique({
+    where: { id: principalUserId },
+    select: { catalogStatus: true },
+  });
+  return row?.catalogStatus ?? CatalogStatus.PENDING;
+}
+
+export async function buildTermsCategoryPlan(
+  manage: Extract<
+    Awaited<ReturnType<typeof resolvePartnershipManageContext>>,
+    { ok: true }
+  >,
+  intendedPartnerType: ReturnType<typeof parseLinkInvitePartnerType>,
+) {
+  const inviterIsStore = await userIsStoreOwner(manage.principalUserId, prisma);
+  const catalogStatus = await principalCatalogStatus(manage.principalUserId);
+  const categoryPlan = categoriesForLinkInviteCreate(
+    {
+      id: manage.principal.id,
+      role: manage.principal.role,
+      partnerType: manage.principal.partnerType,
+      partnerActivities: manage.principal.partnerActivities,
+      storeCategories: manage.principal.storeCategories,
+      specializations: manage.principal.specializations,
+      catalogStatus,
+    },
+    inviterIsStore,
+    intendedPartnerType,
+  );
+
+  let categories = [...categoryPlan.categories];
+  const requiresIntendedType =
+    (manage.principal.partnerType === 'MASTER' || manage.principal.partnerType === 'COMPANY') &&
+    categories.length > 0;
+
+  let planError = categoryPlan.error;
+  if (requiresIntendedType && planError?.includes('предполагаемый тип')) {
+    planError = undefined;
+  }
+  if (categories.length === 0 && !planError) {
+    categories.push(GENERAL_PARTNERSHIP_CATEGORY);
+  }
+
+  return { categories, requiresIntendedType, error: planError };
+}
+
+export async function buildMiniAppPartnershipInviteContext(
+  user: User,
+  role: MiniAppRole,
+  req: NextRequest,
+): Promise<MiniAppPartnershipInviteContext> {
+  if (role === 'agent') {
+    const discussion = await guardMiniAppDiscussionCreate(user, req);
+    if (!discussion.ok) {
+      return { ok: false, status: discussion.status, error: discussion.error };
+    }
+    return {
+      ok: true,
+      kind: 'discussion',
+      nameMaxLength: DISCUSSION_RECIPIENT_LABEL_MAX,
+      noteMaxLength: DISCUSSION_SUBJECT_MAX,
+      inviterBusinessSide: null,
+      categoryPlan: { categories: [], requiresIntendedType: false },
+    };
+  }
+
+  const manage = await resolvePartnershipManageContext(partnershipManageActor(user), req);
+  if (!manage.ok) {
+    return { ok: false, status: manage.status, error: manage.error };
+  }
+
+  const intendedRaw = req.nextUrl.searchParams.get('intendedPartnerType');
+  const intendedPartnerType = parseLinkInvitePartnerType(intendedRaw);
+  if (intendedRaw != null && intendedRaw.trim() !== '' && !intendedPartnerType) {
+    return { ok: false, status: 400, error: 'Неизвестный тип партнёра' };
+  }
+
+  const plan = await buildTermsCategoryPlan(manage, intendedPartnerType);
+
+  return {
+    ok: true,
+    kind: 'terms',
+    nameMaxLength: LINK_INVITE_RECIPIENT_LABEL_MAX,
+    noteMaxLength: MINI_APP_LINK_INVITE_NOTE_MAX,
+    inviterBusinessSide: inviterBusinessSideSnapshot(manage.principal),
+    categoryPlan: plan,
+  };
+}
