+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+import { PartnerType, UserRole } from '@prisma/client';
+
+const mocks = vi.hoisted(() => ({
+  miniRole: vi.fn(),
+  manage: vi.fn(),
+  orgCtx: vi.fn(),
+}));
+
+vi.mock('@/lib/miniAppBootstrap', () => ({
+  resolveMiniAppRoleForUser: (...args: unknown[]) => mocks.miniRole(...args),
+}));
+
+vi.mock('@/lib/employeeWorkspace/partnershipRouteAuth', () => ({
+  resolvePartnershipManageContext: (...args: unknown[]) => mocks.manage(...args),
+}));
+
+vi.mock('@/lib/employeeWorkspace/workplaceContext', () => ({
+  shouldPreferOrgWorkplaceContext: (...args: unknown[]) => mocks.orgCtx(...args),
+}));
+
+import { resolveMiniAppPartnershipInviteRole } from '@/lib/miniAppPartnershipInviteRoute';
+
+describe('resolveMiniAppPartnershipInviteRole', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.miniRole.mockResolvedValue(null);
+    mocks.orgCtx.mockReturnValue(true);
+    mocks.manage.mockResolvedValue({ ok: true, principalUserId: 'owner' });
+  });
+
+  it('keeps direct PRO mini roles unchanged', async () => {
+    mocks.miniRole.mockResolvedValue('agent');
+    const role = await resolveMiniAppPartnershipInviteRole(
+      { id: 'u1', role: UserRole.PRO, isProfTestUser: false } as never,
+      { organization: null, branches: [] } as never,
+      new NextRequest('https://x'),
+    );
+    expect(role).toBe('agent');
+    expect(mocks.manage).not.toHaveBeenCalled();
+  });
+
+  it('maps CLIENT org staff with partnership manage to store/company invite role', async () => {
+    const staff = { id: 'emp', role: UserRole.CLIENT, isProfTestUser: false };
+    const storeCtx = {
+      organization: { partnerType: PartnerType.STORE, id: 'o1' },
+      branches: [],
+    } as never;
+    await expect(
+      resolveMiniAppPartnershipInviteRole(staff as never, storeCtx, new NextRequest('https://x')),
+    ).resolves.toBe('store');
+
+    const companyCtx = {
+      organization: { partnerType: PartnerType.COMPANY, id: 'o2' },
+      branches: [],
+    } as never;
+    await expect(
+      resolveMiniAppPartnershipInviteRole(staff as never, companyCtx, new NextRequest('https://x')),
+    ).resolves.toBe('company');
+    expect(mocks.manage).toHaveBeenCalledWith(
+      expect.objectContaining({ id: 'emp', role: UserRole.CLIENT }),
+      expect.anything(),
+    );
+  });
+
+  it('denies CLIENT without org workplace or manage context', async () => {
+    mocks.orgCtx.mockReturnValue(false);
+    const role = await resolveMiniAppPartnershipInviteRole(
+      { id: 'emp', role: UserRole.CLIENT, isProfTestUser: false } as never,
+      { organization: null, branches: [] } as never,
+      new NextRequest('https://x'),
+    );
+    expect(role).toBeNull();
+
+    mocks.orgCtx.mockReturnValue(true);
+    mocks.manage.mockResolvedValue({ ok: false, status: 403, error: 'Forbidden' });
+    await expect(
+      resolveMiniAppPartnershipInviteRole(
+        { id: 'emp', role: UserRole.CLIENT, isProfTestUser: false } as never,
+        {
+          organization: { partnerType: PartnerType.COMPANY, id: 'o2' },
+          branches: [],
+        } as never,
+        new NextRequest('https://x'),
+      ),
+    ).resolves.toBeNull();
+  });
+});
