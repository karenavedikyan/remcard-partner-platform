+  fetchManagementOverview: vi.fn(),
+}));
+
+vi.mock("next/navigation", () => ({
+  usePathname: () => mocks.pathname,
+  useSearchParams: () => new URLSearchParams(mocks.search),
+}));
+
+import { CookieConsentProvider } from "@/contexts/CookieConsentContext";
