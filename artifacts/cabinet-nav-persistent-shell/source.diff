+import { CabinetAppShellClient } from "@/components/layout/CabinetAppShellClient";
+
+export default async function CabinetRouteGroupLayout({
+  children,
+}: {
+  children: React.ReactNode;
+}) {
+  const user = await peekCabinetSession();
+  if (!user) {
+    return children;
+  }
