+++const CABINET_ROOT = path.join(process.cwd(), "src/app/(cabinet)");
+++
+++const EXPECTED_ROUTE_FILES = [
+++  "page.tsx",
+++  "partners/page.tsx",
+++  "partners/agent-terms/page.tsx",
+++  "clients/page.tsx",
+++  "clients/[id]/page.tsx",
+++  "certificates/page.tsx",
+++  "certificates/new/page.tsx",
+++  "certificates/[id]/page.tsx",
+++  "history/page.tsx",
