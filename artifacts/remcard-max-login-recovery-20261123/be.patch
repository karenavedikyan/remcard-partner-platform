+import type { NextRequest } from 'next/server';
+import type { User } from '@prisma/client';
+import { getAuthenticatedUser } from '@/lib/proAuth';
+import { getProfCabinetUserForMiniApp } from '@/lib/miniAppCabinetAuth';
+import { assertMiniAppAccess, type MiniAppPlatform } from '@/lib/miniAppSessionCookie';
+
+function parseHostPlatform(raw: string | null): MiniAppPlatform | null {
+  const v = raw?.trim().toLowerCase();
+  if (v === 'telegram' || v === 'tg') return 'telegram';
+  if (v === 'max') return 'max';
+  return null;
+}
+
+export function parseMiniAppHostPlatform(req: NextRequest): MiniAppPlatform | null {
+  return (
+    parseHostPlatform(req.headers.get('x-remcard-mini-app-platform')) ??
+    parseHostPlatform(req.nextUrl.searchParams.get('host'))
+  );
+}
+
+/** Trusted mini-app store/certificate handlers: first-party session, else embedded cabinet user. */
+export async function resolveStoreRouteUser(req: NextRequest): Promise<User | null> {
+  const sessionUser = await getAuthenticatedUser(req);
+  if (sessionUser) return sessionUser;
+
+  if (!req.nextUrl.pathname.startsWith('/api/pro/mini-app/')) {
+    return null;
+  }
+
+  const platform = parseMiniAppHostPlatform(req);
+  if (!platform) return null;
+
+  const user = await getProfCabinetUserForMiniApp(req, platform);
+  if (!user) return null;
+
+  const guard = await assertMiniAppAccess(req, platform, user.id);
+  if (!guard.ok) return null;
+
+  return user;
+}
