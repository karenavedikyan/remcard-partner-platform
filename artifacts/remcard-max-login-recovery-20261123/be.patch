+import { certificatePolicyExpiryIso } from '@/lib/certificateReceivingPolicy/moscowExpiry';
+import {
+  canReceiveOnDirection,
+  DIRECTION_BLOCK_MESSAGES,
+  resolvePartnershipDirection,
+  type DirectionBlockNextStep,
+  type DirectionBlockReason,
+} from '@/lib/partnershipDirection';
+
+type SelfBranchSummary = {
+  id: string;
+  name: string;
+  city: string;
+  address: string;
+  catalogStatus: string;
+  isActive: boolean;
+};
+
+// Extended select: include photoUrl + logoUrl so the wizard can render avatars in catalog parity.
+const partnerSideSelect = {
+  id: true,
+  city: true,
+  displayName: true,
+  photoUrl: true,
+  partnerType: true,
+  partnerActivities: true,
+  role: true,
+  isBlocked: true,
+  storeCategories: true,
+  specializations: true,
+  organizationsOwned: {
+    take: 1,
+    orderBy: { createdAt: 'asc' as const },
+    select: {
+      name: true,
+      logoUrl: true,
+      branches: {
+        orderBy: { name: 'asc' as const },
+        select: {
+          id: true,
+          name: true,
+          city: true,
+          address: true,
+          catalogStatus: true,
+          isActive: true,
+        },
+      },
+    },
+  },
+} as const;
+
+type AvailablePartnerRecipientPolicyPreview = {
+  validityDays: number;
+  purchaseLimit: number;
+  minimumPurchaseAmount: number | null;
+  promotionsCompatible: boolean;
+  exclusionsText: string | null;
+  policySource: 'general' | 'individual';
+  validUntil: string | null;
+};
+
+async function previewRecipientPolicyForPartner(input: {
+  receiverUserId: string;
+  issuerUserId: string;
+  partnershipId: string | null;
+  isSelfScan: boolean;
+}): Promise<AvailablePartnerRecipientPolicyPreview | undefined> {
+  try {
+    const terms = await loadEffectiveReceivingPolicyForPreview(input);
+    let validUntil: string | null = null;
+    try {
+      validUntil = certificatePolicyExpiryIso(terms.validityDays, new Date());
+    } catch {
+      // fail closed: preview without a trusted expiry
+    }
+    return {
+      validityDays: terms.validityDays,
+      purchaseLimit: terms.purchaseLimit,
+      minimumPurchaseAmount: terms.minimumPurchaseAmount,
+      promotionsCompatible: terms.promotionsCompatible,
+      exclusionsText: terms.exclusionsText,
+      policySource: terms.policySource,
+      validUntil,
+    };
+  } catch {
+    return undefined;
+  }
+}
+
+
+export async function buildStoreCertificateAvailablePartners(user: User, req: NextRequest): Promise<NextResponse> {
+
+  const proCtx = await getProContext(user.id);
+  const staffResolution = await resolveCertificateStaffIssuer({ userId: user.id, proCtx, userRole: user.role });
+  if (staffResolution.kind === 'deny') {
+    return NextResponse.json({ error: 'Forbidden' }, { status: 403 });
+  }
+  // Branch employees are CLIENT accounts: only a verified issuing employee passes without the PRO role.
+  if (user.role !== UserRole.PRO && staffResolution.kind !== 'ok') {
+    return NextResponse.json({ error: 'Forbidden' }, { status: 403 });
+  }
+  const staff = staffResolution.kind === 'ok' ? staffResolution.staff : null;
+  /** Branch staff issue on behalf of the organization owner: partners and self-scan are the owner's. */
+  const principalUserId = staff?.ownerUserId ?? user.id;
+
+  const { organization: userOrg } = await resolveUserOrganization(user.id);
+  const partnershipUserId = staff ? staff.ownerUserId : (userOrg?.ownerId ?? user.id);
+
+  const currentUser = await prisma.user.findUnique({
+    where: { id: principalUserId },
+    select: {
+      ...certificateRecommendationIssuerUserSelect,
+      id: true,
+      role: true,
+      isBlocked: true,
+      organizationsOwned: {
+        take: 1,
+        orderBy: { createdAt: 'asc' },
+        select: {
+          name: true,
+          branches: {
+            orderBy: { name: 'asc' },
+            select: {
+              id: true,
+              name: true,
+              city: true,
+              address: true,
+              catalogStatus: true,
+              isActive: true,
+            },
+          },
+        },
+      },
+    },
+  });
+
+  const issuerReadiness = currentUser
+    ? resolveCertificateRecommendationIssuerReadiness(
+        recommendationIssuerInputFromUserAndOrg(currentUser, userOrg),
+      )
+    : {
+        ready: false,
+        missingFields: [],
+        isAgentIssuer: false,
+      };
+
+  const partnerships = await prisma.partnership.findMany({
+    where: {
+      status: {
+        in: [
+          PartnershipStatus.ACTIVE,
+          PartnershipStatus.PAUSED,
+          PartnershipStatus.INVITED,
+          PartnershipStatus.PENDING,
+        ],
+      },
+      OR: [{ storeUserId: partnershipUserId }, { proUserId: partnershipUserId }],
+    },
+    include: {
+      terms: true,
+      storeUser: { select: partnerSideSelect },
+      proUser: { select: partnerSideSelect },
+    },
+  });
+
+  type CatRow = {
+    category: string;
+    categoryLabel: string;
+  poolPercent: number;
+    /** false when the partner agreed the category at 0%: kept in terms, but nothing can be issued. */
+    issuable: boolean;
+    discountPercent: number;
+  issuerPercent: number;
+  /** @deprecated Используйте issuerPercent. */
+    proBonusPercent: number;
+  /** @deprecated Используйте poolPercent. */
+    maxDiscount: number;
+  /** @deprecated Используйте poolPercent. */
+    maxBonus: number;
+  /** @deprecated Используйте poolPercent. */
+    maxTotal: number;
+  };
+
+  const partnersOut: Array<{
+    partnershipId: string | null;
+    storeUserId: string;
+    storeName: string;
+    displayName: string | null;
+    photoUrl: string | null;
+    logoUrl: string | null;
+    partnerType: string | null;
+    partnerCategories: string[];
+    city: string | null;
+    isSelfScan: boolean;
+    direction?: 'outgoing';
+    categories: CatRow[];
+    branches: Array<{ id: string; name: string; city: string; address: string }>;
+    programReady: boolean;
+    programMissing: CertificatePartnerPublicProfileMissingField[];
+    recipientPolicy?: AvailablePartnerRecipientPolicyPreview;
+  }> = [];
+
+  type BlockedPartner = {
+    partnerUserId: string;
+    partnershipId: string | null;
+    reversePartnershipId: string | null;
+    storeName: string;
+    partnerType: string | null;
+    reason: DirectionBlockReason;
+    nextStep: DirectionBlockNextStep;
+    message: string;
+    status: PartnershipStatus | null;
+  };
+  const blockedPartners: BlockedPartner[] = [];
+  const outgoingCounterparties = new Set<string>();
+  const incomingRows: Array<(typeof partnerships)[number]> = [];
+
+  const labelFor = (u: (typeof partnerships)[number]['storeUser']) =>
+    partnerCardLabel({
+      displayName: u.displayName,
+      partnerType: u.partnerType,
+      organizationName: u.organizationsOwned[0]?.name?.trim() || null,
+    }) || 'Партнёр';
+
+  for (const partnership of partnerships) {
+    const resolved = resolvePartnershipDirection(
+      partnership,
+      partnership.storeUser,
+      partnership.proUser,
+    );
+    if (resolved.issuerUserId !== partnershipUserId) {
+      incomingRows.push(partnership);
+      continue;
+    }
+    const partner =
+      resolved.receiverUserId === partnership.storeUserId ? partnership.storeUser : partnership.proUser;
+    outgoingCounterparties.add(partner.id);
+
+    if (partnership.status !== PartnershipStatus.ACTIVE) {
+      const reason: DirectionBlockReason =
+        partnership.status === PartnershipStatus.PAUSED ? 'DIRECTION_PAUSED' : 'DIRECTION_PENDING';
+      blockedPartners.push({
+        partnerUserId: partner.id,
+        partnershipId: partnership.id,
