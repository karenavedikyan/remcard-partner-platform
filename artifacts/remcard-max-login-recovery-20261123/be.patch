+      partnerCats = Array.from(new Set(merged));
+    }
+
+    partnersOut.push({
+      partnershipId: partnership.id,
+      storeUserId: partner.id,
+      storeName,
+      displayName: partner.displayName,
+      photoUrl: partner.photoUrl,
+      logoUrl: partner.organizationsOwned[0]?.logoUrl ?? null,
+      partnerType: partner.partnerType,
+      partnerCategories: partnerCats,
+      city: partner.city,
+      isSelfScan: false,
+      direction: 'outgoing',
+      categories,
+      branches: branchRows.map((b) => ({
+        id: b.id,
+        name: b.name,
+        city: b.city,
+        address: b.address,
