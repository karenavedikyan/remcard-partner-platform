+        (b) => !staff || (staff.kind === 'branch' && b.id != null && staff.writableBranchIds.includes(b.id)),
+      );
+      const selfCategories = selfScanCategoryKeysForCertificate(currentUser, userOrg);
+      selfPartner = {
+        partnershipId: null,
+        storeUserId: currentUser.id,
+        storeName: selfOrgName || 'Я сам',
+        displayName: currentUser.displayName ?? null,
+        photoUrl: null,
+        logoUrl: null,
+        partnerType: currentUser.partnerType ?? null,
+        // p123-BS: surface own categories so the wizard renders chips for 'Я сам' too.
+        partnerCategories: selfCategories,
+        city: userOrg?.city ?? currentUser.city,
+        isSelfScan: true,
+        branches: branchRows.map((b) => ({
+          id: b.id,
+          name: b.name,
+          city: b.city,
+          address: b.address,
+        })),
+        categories: selfCategories.map((category: string) => ({
+          category,
+          categoryLabel: getCategoryLabel(category),
+          poolPercent: 100,
+          issuable: true,
+          discountPercent: 10,
+          issuerPercent: 0,
+          proBonusPercent: 0,
+          maxDiscount: 100,
+          maxBonus: 0,
+          maxTotal: 100,
+        })),
+        programReady: true,
+        programMissing: [],
+      };
+    }
+  }
+
+  const partnersOutWithPolicy = await Promise.all(
+    partnersOut.map(async (row) => {
+      const recipientPolicy = await previewRecipientPolicyForPartner({
+        receiverUserId: row.storeUserId,
+        issuerUserId: partnershipUserId,
+        partnershipId: row.partnershipId,
+        isSelfScan: false,
+      });
+      return recipientPolicy ? { ...row, recipientPolicy } : row;
+    }),
+  );
+
+  let selfPartnerFinal = selfPartner;
+  if (selfPartner) {
+    const recipientPolicy = await previewRecipientPolicyForPartner({
+      receiverUserId: selfPartner.storeUserId,
+      issuerUserId: partnershipUserId,
+      partnershipId: null,
+      isSelfScan: true,
+    });
+    selfPartnerFinal = recipientPolicy ? { ...selfPartner, recipientPolicy } : selfPartner;
+  }
+
+  const partnersList = selfPartnerFinal
+    ? [selfPartnerFinal, ...partnersOutWithPolicy]
+    : partnersOutWithPolicy;
+
+  const staffDefaultBranch = staff?.kind === 'branch'
+    ? selectStaffIssuerBranch({
+        staff,
+        explicitBranchId: req.nextUrl.searchParams.get('branchId')?.trim() || null,
+        cookieBranchId: req.cookies?.get(PRO_BRANCH_CONTEXT_COOKIE)?.value?.trim() || null,
+      })
+    : { ok: false as const };
+
+  return NextResponse.json({
+    partners: partnersList,
+    blockedPartners,
+    certificateProgramSelfReady: selfPartner != null,
+    certificateProgramSelfMissing:
+      selfPartner != null ? [] : certificateProgramSelfMissing,
+    certificateRecommendationIssuerReady: issuerReadiness.ready,
+    certificateRecommendationIssuerMissing: issuerReadiness.missingFields,
+    isAgentRecommender: issuerReadiness.isAgentIssuer,
+    selfBranches,
+    ...(staff?.kind === 'branch'
+      ? {
+          staffIssuer: {
+            branchIds: staff.writableBranchIds,
+            defaultBranchId: staffDefaultBranch.ok ? staffDefaultBranch.branchId : null,
+          },
+        }
+      : {}),
+    certificateProgramHint:
+      selfPartner == null && currentUser && !issuerReadiness.isAgentIssuer
+        ? 'Чтобы участвовать в программе сертификатов, заполните публичные данные, которые увидит клиент: название организации, город и категории со скидками.'
+        : undefined,
+  });
+}
