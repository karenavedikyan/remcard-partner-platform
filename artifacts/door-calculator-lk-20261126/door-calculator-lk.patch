+/* Калькулятор дверей. Токены совпадают с сайтом remcard.ru и кабинетом партнёра */
+:root{--bg:#f6f5f3;--surface:#fff;--offset:#f2f1ee;--ink:#252923;--muted:#6c706a;--line:#e5e5df;--primary:#c12b2f;--primary-hover:#a72226;--soft:#fcf0ed;--green:#35684b;--green-soft:#eef5ef;--amber:#865c20;--amber-soft:#fbf3e3;--on-ink:#fff;--header-bg:rgba(246,245,243,.9);--glass:rgba(255,255,255,.94);--shadow:0 24px 80px rgba(39,43,36,.15);--shadow-sm:0 6px 24px rgba(39,43,36,.08);--proto-bg:#fdf9ef;--proto-line:#d9c9a3;--sc-bg:#f1efea;--sc-wall:#e9e6de;--sc-floor:#d9d4c8;--r-sm:8px;--r-md:12px;--r-lg:16px;--r-xl:20px;--font:"Manrope",system-ui,-apple-system,"Segoe UI",sans-serif;color-scheme:light}
+[data-theme=dark]{--bg:#131917;--surface:#1c2421;--offset:#25312b;--ink:#eaf0ec;--muted:#a6b5ac;--line:rgba(210,236,220,.14);--primary:#f3786d;--primary-hover:#ff9288;--soft:#372a27;--green:#a4d2b1;--green-soft:#253b2c;--amber:#e8c27a;--amber-soft:#3a301b;--on-ink:#141816;--header-bg:rgba(19,25,23,.88);--glass:rgba(28,36,33,.94);--shadow:0 24px 80px rgba(0,0,0,.45);--shadow-sm:0 6px 24px rgba(0,0,0,.35);--proto-bg:#2a2719;--proto-line:#6b5a2e;--sc-bg:#232c28;--sc-wall:#303b36;--sc-floor:#262f2b;color-scheme:dark}
+*{box-sizing:border-box}
+html{-webkit-text-size-adjust:100%}
+.door-wizard{font-family:var(--font);color:var(--ink);line-height:1.5;font-size:1rem;-webkit-font-smoothing:antialiased}
+a{color:inherit;text-decoration:none}
+button,input,select{font:inherit;color:inherit}
+button{cursor:pointer;border:0;background:none;padding:0;-webkit-tap-highlight-color:transparent}
+h1,h2,p,ul,dl,dd{margin:0}
+input,select{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);padding:.65rem .9rem;width:100%;outline:none;min-height:46px;font-weight:600;font-size:1rem}
+input:focus,select:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(193,43,47,.14)}
+input::placeholder{color:var(--muted);opacity:.75;font-weight:500}
+input[type=number]{-moz-appearance:textfield}
+input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
+:focus-visible{outline:3px solid var(--primary);outline-offset:2px}
+input:focus-visible,select:focus-visible{outline:none}
+.i{width:20px;height:20px;flex:none}
+.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
+.eyebrow{display:inline-flex;align-items:center;gap:.45rem;font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
+
+/* полоса прототипа */
+.proto{display:flex;align-items:center;gap:14px;padding:6px 20px;background:var(--proto-bg);border-bottom:1px solid var(--proto-line);font-size:12px;font-weight:600;color:var(--muted)}
+.proto__sw{display:inline-flex;margin-left:auto;border:1px solid var(--proto-line);border-radius:99px;overflow:hidden;background:var(--surface)}
+.proto__sw a{padding:4px 12px;font-weight:700;white-space:nowrap}
+.proto__sw a.on{background:var(--ink);color:var(--on-ink)}
+.proto__all{text-decoration:underline;text-underline-offset:3px;white-space:nowrap}
+
+/* шапка */
+.hdr{position:sticky;top:0;z-index:50;background:var(--header-bg);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
+.hdr__in{height:64px;display:flex;align-items:center;gap:1.5rem}
+.hdr__in--lk{padding:0 24px}
+.brand{display:inline-flex;align-items:center;gap:.65rem}
+.brand__mark{width:36px;height:36px;color:var(--primary);flex:none}
+.brand__text{display:flex;flex-direction:column;line-height:1}
+.brand__word{font-size:1.5rem;font-weight:800;letter-spacing:-.07em}
+.brand__word i{font-style:normal;color:var(--primary)}
+.brand__sub{font-size:11px;color:var(--muted);font-weight:600;letter-spacing:.02em;margin-top:3px}
+.nav{display:flex;gap:.25rem;margin-left:.5rem}
+.nav a{padding:.5rem .85rem;border-radius:var(--r-sm);font-weight:700;font-size:.875rem;color:var(--muted)}
+.nav a:hover{color:var(--ink);background:var(--offset)}
+.nav a.is-active{color:var(--ink);background:var(--surface);box-shadow:inset 0 0 0 1px var(--line)}
+.hdr__right{margin-left:auto;display:flex;gap:.6rem;align-items:center}
+.hdr .hdr__burger{display:none}
+.who{display:flex;align-items:center;gap:.6rem}
+.who__av{width:38px;height:38px;border-radius:50%;background:var(--offset);display:grid;place-items:center;font-weight:800;font-size:.8rem}
+.who__t{display:flex;flex-direction:column;line-height:1.25}.who__t b{font-size:.875rem}.who__t small{font-size:.75rem;color:var(--muted)}
+
+/* кнопки */
+.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:46px;padding:.65rem 1.15rem;border-radius:var(--r-md);font-weight:700;font-size:.875rem;border:1px solid transparent;transition:background .15s,border-color .15s,color .15s,transform .1s;white-space:nowrap}
+.btn:active{transform:translateY(1px)}
+.btn:disabled{opacity:.45;cursor:not-allowed}
+.btn--primary{background:var(--primary);color:#fff}
+[data-theme=dark] .btn--primary{color:#1a0d0b}
+.btn--primary:hover:not(:disabled){background:var(--primary-hover)}
+.btn--ghost{background:var(--surface);border-color:var(--line)}
+.btn--ghost:hover:not(:disabled){border-color:var(--ink)}
+.btn--text{color:var(--muted)}.btn--text:hover:not(:disabled){color:var(--primary)}
+.btn--sm{min-height:38px;padding:.35rem .85rem;font-size:.8125rem;border-radius:10px}
+.btn--sm .i{width:16px;height:16px}
+.btn--lg{min-height:56px;padding:.9rem 1.5rem;font-size:1rem;border-radius:14px}
+.iconbtn{width:44px;height:44px;border-radius:var(--r-md);border:1px solid var(--line);background:var(--surface);display:inline-grid;place-items:center;flex:none;transition:border-color .15s}
+.iconbtn:hover:not(:disabled){border-color:var(--ink)}
+.iconbtn:disabled{opacity:.4;cursor:default}
+
+/* кабинет */
+.ctx-lk .shell{display:grid;grid-template-columns:248px minmax(0,1fr)}
+.side{border-right:1px solid var(--line);padding:20px 16px;position:sticky;top:64px;height:calc(100vh - 64px);overflow:auto;background:var(--surface)}
+.ws{border:1px solid var(--line);border-radius:var(--r-lg);padding:14px 16px;display:flex;flex-direction:column;gap:2px;margin-bottom:16px}
+.ws strong{font-size:1rem}.ws small{color:var(--muted);font-size:.78rem}
+.navbtn{display:flex;align-items:center;gap:.75rem;padding:.7rem .85rem;border-radius:10px;font-weight:700;font-size:.9rem}
+.navbtn:hover{background:var(--offset)}
+.navbtn.on{background:var(--soft);color:var(--primary)}
+.side__n{font-size:.75rem;color:var(--muted);margin-top:16px;padding:0 .5rem}
+.page{padding:20px 20px 150px;min-width:0}
+.page__in{max-width:1040px;margin:0 auto}
+.crumbs{display:flex;align-items:center;gap:.35rem;font-size:.8125rem;color:var(--muted);font-weight:600;margin-bottom:14px;flex-wrap:wrap}
+.crumbs a:hover{color:var(--ink)}.crumbs .i{width:14px;height:14px}.crumbs span{color:var(--ink)}
+
+/* шаги */
+.wtop{display:flex;align-items:center;gap:14px;margin-bottom:26px}
+.wprog{flex:1;display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
+.wprog i{height:6px;border-radius:9px;background:var(--line);transition:background .25s}
+.wprog i.on{background:var(--primary)}.wprog i.done{background:var(--ink)}
+.wz{margin:0 auto}
+.wz.enter{animation:in .28s cubic-bezier(.2,.7,.3,1)}
+@keyframes in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
+.wz--1{max-width:560px}
+.scr h1{font-size:clamp(1.75rem,1.35rem + 1.8vw,2.5rem);line-height:1.12;font-weight:800;letter-spacing:-.035em;margin:.5rem 0 .6rem}
+.lead{color:var(--muted);font-size:1.0625rem;max-width:56ch}
+
+/* шаг 1 */
+.count{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:36px 0 18px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-xl);padding:22px;box-shadow:var(--shadow-sm)}
+.count__n{display:flex;flex-direction:column;align-items:center;line-height:1}
+.count__n b{font-size:clamp(5rem,4rem + 6vw,7rem);font-weight:800;letter-spacing:-.06em;font-variant-numeric:tabular-nums}
+.count__n span{font-size:.9rem;color:var(--muted);font-weight:700;margin-top:6px}
+.count__b{width:64px;height:64px;border-radius:50%;border:1px solid var(--line);background:var(--offset);display:grid;place-items:center;transition:.15s}
+.count__b .i{width:26px;height:26px}
+.count__b:hover:not(:disabled){background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
+.count__b:disabled{opacity:.35;cursor:default}
+.doors{display:flex;justify-content:center;align-items:flex-end;gap:7px;min-height:40px;flex-wrap:wrap}
+.doors i{width:20px;height:34px;border:2px solid var(--ink);border-radius:3px 3px 0 0;border-bottom-width:0;position:relative;opacity:.8;animation:in .2s}
+.doors i:after{content:"";position:absolute;right:3px;top:16px;width:3px;height:3px;border-radius:50%;background:var(--ink)}
+.doors span{font-weight:800;font-size:.85rem;color:var(--muted)}
+.quick{display:flex;justify-content:center;gap:8px;margin-top:22px}
+.quick button{flex:1;max-width:64px;height:48px;border-radius:var(--r-md);border:1px solid var(--line);background:var(--surface);font-weight:800;transition:.15s}
+.quick button:hover{border-color:var(--ink)}
+.quick button.on{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
+
+/* переключатели */
+.seg{display:inline-flex;border:1px solid var(--line);border-radius:var(--r-md);overflow:hidden;background:var(--surface)}
+.seg--full{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;width:100%}
+.seg button{padding:.7rem .5rem;font-weight:700;font-size:.875rem;color:var(--muted);border-right:1px solid var(--line);white-space:nowrap;min-height:46px;transition:.15s}
+.seg button:last-child{border-right:0}
+.seg button:hover{color:var(--ink)}
+.seg button.is-on{background:var(--ink);color:var(--on-ink)}
