diff --git a/client/style.css b/client/style.css
index 71c8566..2f7f08b 100644
--- a/client/style.css
+++ b/client/style.css
@@ -3769,3 +3769,15 @@ fieldset.calc-wizard__fields:disabled textarea {
 .me-offer-notice{margin-top:.75rem;padding:.65rem .75rem;background:var(--surface-2);border:1px solid var(--line);border-radius:.6rem;font-size:.85rem}
 .me-offer-notice summary{cursor:pointer;font-weight:750}
 .me-offer-channel-list{display:flex;gap:.3rem;flex-wrap:wrap;margin:.55rem 0}
+
+/* Вход в калькулятор: выбор «весь ремонт» или «отдельный расчёт» */
+.cs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; }
+.cs-card { display: grid; grid-template-columns: auto 1fr auto; gap: .9rem; align-items: center; padding: 1.1rem 1.15rem; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); color: var(--ink); text-decoration: none; transition: .15s; min-width: 0; }
+.cs-card:hover { border-color: var(--ink); }
+.cs-card b { display: block; font-size: var(--text-lg, 1.1rem); margin-bottom: .2rem; }
+.cs-card small { color: var(--muted); font-size: var(--text-sm); line-height: 1.4; display: block; }
+.cs-h2 { font-size: var(--text-base, 1rem); margin: 1.6rem 0 .7rem; }
+.cs-tiles { margin-top: 0; }
+@media (max-width: 720px) { .cs-grid { grid-template-columns: 1fr; } }
+.cs-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
+@media (max-width: 720px) { .cs-tiles { grid-template-columns: 1fr 1fr; } }
