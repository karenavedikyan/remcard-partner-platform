+      organization: null,
+      branches: [],
+      activeBranch: null,
+      branchRole: null,
+      employer: null,
+      employeeRole: null,
+    });
+    mockPartnershipTerms.mockResolvedValue([{ category: 'doors', storePercent: 15 }]);
+    mockCertFindFirst.mockResolvedValue({
+      id: 'cert-1',
+      proUserId: 'pro-1',
+      promoCode: 'RC-TEST',
+      qrCode: 'qr',
+      issuerKindSnapshot: 'SPECIALIST',
+      status: CertificateStatus.ACTIVE,
+      validUntil: null,
+      usageCount: 0,
+      maxUsages: 3,
+      branchId: null,
+      partners: [partnerRow],
+      proUser: { companyKind: null, partnerActivities: [] },
+    });
+  });
+
+  it('returns 400 above live pool without opening transaction', async () => {
+    const { POST } = await import('../route');
+    const res = await POST(
+      new NextRequest('https://x/api/store/order', {
+        method: 'POST',
+        body: JSON.stringify({
+          certificateCode: 'RC-TEST',
+          items: [{ category: 'doors', categoryLabel: 'Двери', amount: 10_000, discountPercent: 15.01 }],
