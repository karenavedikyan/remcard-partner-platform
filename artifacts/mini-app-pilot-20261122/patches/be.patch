@@ -0,0 +1,73 @@
+import { categoryIssuerPercent, normalizePercent } from '@/lib/certificatePool';
+import { partnerHasRecipientPolicySnapshot } from '@/lib/store/recipientPolicyUsage';
+
+export type CategoryPoolRow = {
+  category: string;
+  discountPercent?: number | null;
+  issuerPercent?: number | null;
+  proBonusPercent?: number | null;
+  agentBonusPercent?: number | null;
+};
+
+/**
+ * Category client-discount limits at store order PREVIEW + POST:
+ *
+ * - **Snapshot recipient** (`policySnapshotJson`): max = live `PartnershipTerm.storePercent` when the
+ *   category is on the partnership; otherwise frozen certificate pool. Transaction re-reads terms under lock.
+ * - **Legacy / self-scan without snapshot**: max = frozen offered + issuer percents on the certificate line only.
+ * - Issuer bonus at purchase: `max(pool − appliedClient, 0)` on the same pool base (gross before discount).
+ * - Own-certificate self-scan does not accrue PROF (unchanged order path).
+ */
+
+/** Legacy / self-scan: frozen certificate line (offered client % + frozen issuer %). */
+export function frozenCategoryPoolPercent(category: CategoryPoolRow): number {
+  const offered = normalizePercent(Number(category.discountPercent ?? 0));
+  return normalizePercent(offered + categoryIssuerPercent(category));
+}
+
+export type StoreOrderCategoryLimitMode = 'live_partnership' | 'frozen_certificate';
+
+/**
+ * Snapshot recipients use live partnership `storePercent` when terms exist (transaction recomputes PROF).
+ * Legacy consumption and self-scan without snapshot use frozen certificate pools only.
+ */
+export function resolveStoreOrderCategoryLimitMode(partner: {
+  policySnapshotJson?: unknown | null;
+}): StoreOrderCategoryLimitMode {
+  return partnerHasRecipientPolicySnapshot(partner) ? 'live_partnership' : 'frozen_certificate';
+}
+
+/**
+ * Maximum client discount % allowed at purchase for this category (PREVIEW + POST preflight + tx authority).
+ */
+export function resolveEffectiveClientDiscountMaxPercent(
+  mode: StoreOrderCategoryLimitMode,
+  category: CategoryPoolRow,
+  liveStorePercent: number | undefined,
+): number {
+  if (mode === 'live_partnership') {
+    if (liveStorePercent !== undefined && Number.isFinite(liveStorePercent)) {
+      return normalizePercent(liveStorePercent);
+    }
+    return frozenCategoryPoolPercent(category);
+  }
+  return frozenCategoryPoolPercent(category);
+}
+
+export function buildLivePartnershipPoolMap(
+  terms: Array<{ category: string; storePercent: number }>,
+): Map<string, number> {
+  return new Map(terms.map((t) => [t.category, normalizePercent(Number(t.storePercent))]));
+}
+
+export async function loadLivePartnershipPoolByCategory(
+  partnershipId: string | null | undefined,
+  db: { partnershipTerm: { findMany: (args: unknown) => Promise<Array<{ category: string; storePercent: number }>> } },
+): Promise<Map<string, number>> {
+  if (!partnershipId) return new Map();
+  const terms = await db.partnershipTerm.findMany({
+    where: { partnershipId, isExcluded: false },
+    select: { category: true, storePercent: true },
+  });
+  return buildLivePartnershipPoolMap(terms);
+}
