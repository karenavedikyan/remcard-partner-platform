+/** Reject client % more than this many points above the category pool (e.g. pool 15 → 15.01 invalid). */
+export const CLIENT_DISCOUNT_POOL_TOLERANCE_PP = 0.01;
+
+export function clientDiscountExceedsCategoryPool(
+  appliedClientPercent: number,
+  poolPercent: number,
+): boolean {
+  const applied = Number.isFinite(appliedClientPercent) ? appliedClientPercent : 0;
+  const pool = Number.isFinite(poolPercent) ? poolPercent : 0;
+  return applied - pool > CLIENT_DISCOUNT_POOL_TOLERANCE_PP - 1e-9;
+}
+
 /**
  * Issuer bonus at purchase: max(current category pool − **applied** client discount, 0).
  * Certificate offered % is default; applied % may differ by agreement (persisted on order line).
