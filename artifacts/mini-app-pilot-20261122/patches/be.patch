+import { describe, expect, it } from 'vitest';
+import { issuerBonusPercentFromFrozenDiscount } from '@/lib/certificateReceivingPolicy/purchaseIssuerBonus';
+import { buildStoreOrderPreviewCategories } from '@/lib/store/storeOrderPreviewCategories';
+
+describe('buildStoreOrderPreviewCategories', () => {
+  it('uses live pool minus frozen discount for issuerPercent', async () => {
+    const categories = await buildStoreOrderPreviewCategories(
+      {
+        partnershipId: 'p1',
+        policySnapshotJson: { purchaseLimit: 3 },
+        categories: [
+          {
+            category: 'doors',
+            categoryLabel: 'Двери',
+            discountPercent: 7,
+            issuerPercent: 8,
+            isExcluded: false,
+          },
+        ],
+      },
+      {
+        partnershipTerm: {
+          findMany: async () => [{ category: 'doors', storePercent: 10 }],
+        },
+      } as never,
+    );
+    expect(categories[0]!.maxClientDiscountPercent).toBe(10);
+    expect(categories[0]!.issuerPercent).toBe(3);
+    expect(issuerBonusPercentFromFrozenDiscount(7, 5)).toBe(0);
+  });
+
+  it('exposes live max 20 when frozen pool is 15 (offered 10 + issuer 5)', async () => {
+    const categories = await buildStoreOrderPreviewCategories(
+      {
+        partnershipId: 'p1',
+        policySnapshotJson: { purchaseLimit: 1 },
+        categories: [
+          {
+            category: 'doors',
+            categoryLabel: 'Двери',
+            discountPercent: 10,
+            issuerPercent: 5,
+            isExcluded: false,
+          },
+        ],
+      },
+      {
+        partnershipTerm: {
+          findMany: async () => [{ category: 'doors', storePercent: 20 }],
+        },
+      } as never,
+    );
+    expect(categories[0]!.maxClientDiscountPercent).toBe(20);
+    expect(categories[0]!.issuerPercent).toBe(10);
+  });
+
+  it('when live pool 12, max is 12 not offered+max(0)', async () => {
+    const categories = await buildStoreOrderPreviewCategories(
+      {
+        partnershipId: 'p1',
+        policySnapshotJson: {},
+        categories: [
+          {
+            category: 'doors',
+            categoryLabel: 'Двери',
+            discountPercent: 10,
+            issuerPercent: 5,
+            isExcluded: false,
+          },
+        ],
+      },
+      {
+        partnershipTerm: {
+          findMany: async () => [{ category: 'doors', storePercent: 12 }],
+        },
+      } as never,
+    );
+    expect(categories[0]!.maxClientDiscountPercent).toBe(12);
+    expect(categories[0]!.issuerPercent).toBe(2);
+  });
+});
