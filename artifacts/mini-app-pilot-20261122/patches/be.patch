+import { describe, expect, it } from 'vitest';
+import { buildStoreOrderPreviewCategories } from '@/lib/store/storeOrderPreviewCategories';
+import { prepareStoreOrderItems } from '@/lib/store/orderCreate';
+
+const mockDb = (storePercent: number) =>
+  ({
+    partnershipTerm: {
+      findMany: async () => [{ category: 'doors', storePercent }],
+    },
+  }) as never;
+
+const certPartnerBase = {
+  partnershipId: 'p1',
+  policySnapshotJson: { purchaseLimit: 5 },
+  categories: [
+    {
+      category: 'doors',
+      categoryLabel: 'Двери',
+      discountPercent: 10,
+      issuerPercent: 5,
+      isExcluded: false,
+    },
+  ],
+};
+
+describe('store order preview vs POST preflight parity', () => {
+  it('live 20: preview max 20 and POST accepts 20', async () => {
+    const preview = await buildStoreOrderPreviewCategories(certPartnerBase, mockDb(20));
+    expect(preview[0]!.maxClientDiscountPercent).toBe(20);
+    const post = prepareStoreOrderItems(
+      [{ category: 'doors', categoryLabel: 'Двери', amount: 10_000, discountPercent: 20 }],
+      new Map([['doors', certPartnerBase.categories[0] as never]]),
+      {
+        limitMode: 'live_partnership',
+        livePoolByCategory: new Map([['doors', 20]]),
+      },
+    );
+    expect('error' in post).toBe(false);
+    if (!('error' in post)) {
+      expect(post.orderItems[0]?.issuerPercent).toBe(0);
+    }
+  });
+
+  it('live 12: preview max 12, POST rejects 12.01', async () => {
+    const preview = await buildStoreOrderPreviewCategories(certPartnerBase, mockDb(12));
+    expect(preview[0]!.maxClientDiscountPercent).toBe(12);
+    const bad = prepareStoreOrderItems(
+      [{ category: 'doors', categoryLabel: 'Двери', amount: 10_000, discountPercent: 12.01 }],
+      new Map([['doors', certPartnerBase.categories[0] as never]]),
+      {
+        limitMode: 'live_partnership',
+        livePoolByCategory: new Map([['doors', 12]]),
+      },
+    );
+    expect('error' in bad).toBe(true);
+  });
+});
