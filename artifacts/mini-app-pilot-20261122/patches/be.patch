+import { describe, expect, it } from 'vitest';
+import {
+  frozenCategoryPoolPercent,
+  resolveEffectiveClientDiscountMaxPercent,
+  resolveStoreOrderCategoryLimitMode,
+} from '@/lib/store/storeOrderCategoryLimit';
+
+const row = {
+  category: 'doors',
+  discountPercent: 10,
+  issuerPercent: 5,
+};
+
+describe('storeOrderCategoryLimit', () => {
+  it('frozen pool is offered + issuer (15 for 10+5)', () => {
+    expect(frozenCategoryPoolPercent(row)).toBe(15);
+  });
+
+  it('live_partnership uses storePercent when present (20 over frozen 15)', () => {
+    expect(resolveEffectiveClientDiscountMaxPercent('live_partnership', row, 20)).toBe(20);
+  });
+
+  it('live_partnership falls back to frozen when term missing', () => {
+    expect(resolveEffectiveClientDiscountMaxPercent('live_partnership', row, undefined)).toBe(15);
+  });
+
+  it('frozen_certificate ignores live term', () => {
+    expect(resolveEffectiveClientDiscountMaxPercent('frozen_certificate', row, 20)).toBe(15);
+  });
+
+  it('live pool below offered still returns live cap (12 with offered 10)', () => {
+    expect(resolveEffectiveClientDiscountMaxPercent('live_partnership', row, 12)).toBe(12);
+  });
+
+  it('live pool 8 below offered 10', () => {
+    expect(resolveEffectiveClientDiscountMaxPercent('live_partnership', row, 8)).toBe(8);
+  });
+
+  it('snapshot partner selects live mode', () => {
+    expect(resolveStoreOrderCategoryLimitMode({ policySnapshotJson: { purchaseLimit: 1 } })).toBe(
+      'live_partnership',
+    );
+  });
+
+  it('legacy partner selects frozen mode', () => {
+    expect(resolveStoreOrderCategoryLimitMode({ policySnapshotJson: null })).toBe('frozen_certificate');
+  });
+});
