+++export function resolveIssuerPayoutPoolPercentForPreview(
+++  partner: { policySnapshotJson?: unknown | null; partnershipId: string | null },
+++  category: CategoryPoolRow,
+++  liveStorePercent: number | undefined,
+++): number {
+++  const snapshot = partnerHasRecipientPolicySnapshot(partner);
+++  if (snapshot && partner.partnershipId) {
+++    return partnershipAccrualPoolPercent(liveStorePercent);
+++  }
+++  return frozenCategoryPoolPercent(category);
+++}
+++
+++/** Under partnership lock: cap uses live-or-frozen fallback; accrual uses live only. */
+++export function resolveSnapshotTransactionCategoryPools(
+++  category: CategoryPoolRow,
+++  liveStorePercent: number | undefined,
+++): { discountCapPercent: number; accrualPoolPercent: number } {
+++  return {
+++    discountCapPercent: resolveEffectiveClientDiscountMaxPercent(
+++      'live_partnership',
+++      category,
+++      liveStorePercent,
+++    ),
+++    accrualPoolPercent: partnershipAccrualPoolPercent(liveStorePercent),
+++  };
+++}
+++
+++export async function loadLivePartnershipPoolByCategory(
+++  partnershipId: string | null | undefined,
+++  db: Prisma.TransactionClient | typeof prisma = prisma,
+++): Promise<Map<string, number>> {
