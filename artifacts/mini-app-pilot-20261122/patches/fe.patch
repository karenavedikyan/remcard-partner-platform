+++ * Legacy consumption and self-scan without snapshot use frozen certificate pools only.
+++ */
+++export function resolveStoreOrderCategoryLimitMode(partner: {
+++  policySnapshotJson?: unknown | null;
+++}): StoreOrderCategoryLimitMode {
+++  return partnerHasRecipientPolicySnapshot(partner) ? 'live_partnership' : 'frozen_certificate';
+++}
+++
+++/**
+++ * Maximum client discount % allowed at purchase for this category (PREVIEW + POST preflight + tx authority).
+++ */
+++export function resolveEffectiveClientDiscountMaxPercent(
+++  mode: StoreOrderCategoryLimitMode,
+++  category: CategoryPoolRow,
+++  liveStorePercent: number | undefined,
+++): number {
+++  if (mode === 'live_partnership') {
+++    if (liveStorePercent !== undefined && Number.isFinite(liveStorePercent)) {
+++      return normalizePercent(liveStorePercent);
+++    }
+++    return frozenCategoryPoolPercent(category);
+++  }
+++  return frozenCategoryPoolPercent(category);
+++}
+++
+++export function buildLivePartnershipPoolMap(
+++  terms: Array<{ category: string; storePercent: number }>,
+++): Map<string, number> {
+++  return new Map(terms.map((t) => [t.category, normalizePercent(Number(t.storePercent))]));
+++}
+++
+++/** Live partnership pool for PROF accrual (transaction). Missing/excluded active term → 0. */
+++export function partnershipAccrualPoolPercent(liveStorePercent: number | undefined): number {
+++  if (liveStorePercent === undefined || !Number.isFinite(liveStorePercent)) {
+++    return 0;
+++  }
+++  return normalizePercent(liveStorePercent);
+++}
+++
+++/**
+++ * Preview PROF pool: live accrual only for snapshot + partnership (same path as
