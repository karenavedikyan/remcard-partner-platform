+import { AgentCertificatesList } from "./AgentCertificatesList";
+import { fetchAgentCertificates } from "@/lib/agent-r03/api";
+
+vi.mock("qrcode", () => ({
+  default: { toDataURL: vi.fn().mockResolvedValue("data:image/png;base64,test") },
