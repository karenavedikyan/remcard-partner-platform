@@ -0,0 +1,30 @@
+import styles from "./WelcomeContentAreaPending.module.css";
+
+type WelcomeContentAreaPendingProps = {
+  testId?: string;
+  label?: string;
+};
+
+/** Neutral compact placeholder until welcome vs list eligibility is known. */
+export function WelcomeContentAreaPending({
+  testId = "welcome-content-area-pending",
+  label = "Загрузка раздела",
+}: WelcomeContentAreaPendingProps) {
+  return (
+    <div
+      className={styles.root}
+      role="status"
+      aria-live="polite"
+      aria-busy="true"
+      aria-label={label}
+      data-testid={testId}
+    >
+      <span className={styles.barWide} aria-hidden />
+      <span className={styles.barMedium} aria-hidden />
+      <div className={styles.blockRow} aria-hidden>
+        <span className={styles.block} />
+        <span className={styles.block} />
+      </div>
+    </div>
+  );
+}
diff --git a/src/lib/welcome-first-paint/welcomeFirstPaintPending.test.tsx b/src/lib/welcome-first-paint/welcomeFirstPaintPending.test.tsx
new file mode 100644
index 00000000..28657739
--- /dev/null
+++ b/src/lib/welcome-first-paint/welcomeFirstPaintPending.test.tsx
@@ -0,0 +1,125 @@
+import { describe, expect, it } from "vitest";
+import {
+  isCertificatesWelcomeDecisionPending,
+  isClientsWelcomeDecisionPending,
+  isHomeMetricsPresentationPending,
+  isPartnersOverviewPresentationPending,
+  isRecommendationsWelcomeDecisionPending,
+  isScannerWelcomeDecisionPending,
+  isTeamWelcomeDecisionPending,
+} from "./welcomeFirstPaintPending";
+
+describe("welcomeFirstPaintPending helpers", () => {
+  it("clients pending only on baseline initial load", () => {
+    expect(
+      isClientsWelcomeDecisionPending({
+        loadState: "loading",
+        page: 1,
+        appliedQ: "",
+        archived: false,
+        sort: "updated_desc",
+        itemsLength: 0,
+      }),
+    ).toBe(true);
+    expect(
+      isClientsWelcomeDecisionPending({
+        loadState: "loading",
+        page: 1,
+        appliedQ: "x",
+        archived: false,
+        sort: "updated_desc",
+        itemsLength: 0,
+      }),
+    ).toBe(false);
+    expect(
+      isClientsWelcomeDecisionPending({
+        loadState: "loading",
+        page: 1,
+        appliedQ: "",
+        archived: false,
+        sort: "updated_desc",
+        itemsLength: 2,
+      }),
+    ).toBe(false);
+  });
+
+  it("certificates pending respects filters and retained rows", () => {
+    expect(
+      isCertificatesWelcomeDecisionPending({
+        loadState: "loading",
+        itemsLength: 0,
+        archived: false,
+        filtersActive: false,
+      }),
+    ).toBe(true);
+    expect(
+      isCertificatesWelcomeDecisionPending({
+        loadState: "loading",
+        itemsLength: 0,
+        archived: true,
+        filtersActive: false,
+      }),
+    ).toBe(false);
+  });
+
+  it("partners pending only for unresolved initial load", () => {
+    expect(
+      isPartnersOverviewPresentationPending({ loading: true, listReady: false, error: "" }),
+    ).toBe(true);
+    expect(
+      isPartnersOverviewPresentationPending({ loading: false, listReady: false, error: "" }),
+    ).toBe(true);
+    expect(
+      isPartnersOverviewPresentationPending({ loading: false, listReady: true, error: "" }),
+    ).toBe(false);
+    expect(
+      isPartnersOverviewPresentationPending({
+        loading: true,
+        listReady: true,
+        error: "",
+      }),
+    ).toBe(false);
+  });
+
+  it("partners errors and malformed outcomes are not pending", () => {
+    expect(
+      isPartnersOverviewPresentationPending({
+        loading: false,
+        listReady: false,
+        error: "Не удалось загрузить список",
+      }),
+    ).toBe(false);
+    expect(
+      isPartnersOverviewPresentationPending({
+        loading: false,
+        listReady: false,
+        error: "Forbidden",
+      }),
+    ).toBe(false);
+  });
+
+  it("scanner pending for idle and loading probes", () => {
+    expect(isScannerWelcomeDecisionPending({ status: "loading" })).toBe(true);
+    expect(isScannerWelcomeDecisionPending({ status: "idle" })).toBe(true);
+    expect(isScannerWelcomeDecisionPending({ status: "empty_confirmed" })).toBe(false);
+  });
+
+  it("team pending while loading without error", () => {
+    expect(isTeamWelcomeDecisionPending({ loading: true, error: "" })).toBe(true);
+    expect(isTeamWelcomeDecisionPending({ loading: true, error: "fail" })).toBe(false);
+  });
+
+  it("home metrics pending while loadState loading", () => {
+    expect(isHomeMetricsPresentationPending("loading")).toBe(true);
+    expect(isHomeMetricsPresentationPending("loaded")).toBe(false);
+  });
+
+  it("recommendations pending on initial fetch", () => {
+    expect(
+      isRecommendationsWelcomeDecisionPending({ loadState: "loading", itemsLength: 0 }),
+    ).toBe(true);
+    expect(
+      isRecommendationsWelcomeDecisionPending({ loadState: "loading", itemsLength: 1 }),
+    ).toBe(false);
+  });
+});
diff --git a/src/lib/welcome-first-paint/welcomeFirstPaintPending.ts b/src/lib/welcome-first-paint/welcomeFirstPaintPending.ts
new file mode 100644
index 00000000..3f2e23cf
--- /dev/null
+++ b/src/lib/welcome-first-paint/welcomeFirstPaintPending.ts
@@ -0,0 +1,68 @@
+import type { AgentR03ListSort } from "@/lib/agent-r03/types";
+import type { ScannerEmptyActivityProbe } from "@/lib/scanner-empty/eligibility";
+
+/** Initial baseline list fetch — hide legacy chrome until load settles (not filter refetch). */
+export function isClientsWelcomeDecisionPending(input: {
+  loadState: "loading" | "loaded" | "error";
+  page: number;
+  appliedQ: string;
+  archived: boolean;
+  sort: AgentR03ListSort;
+  itemsLength: number;
+}): boolean {
+  if (input.loadState !== "loading") return false;
+  if (input.itemsLength > 0) return false;
+  if (input.page !== 1) return false;
+  if (input.archived) return false;
+  if (input.appliedQ.trim()) return false;
+  if (input.sort !== "updated_desc") return false;
+  return true;
+}
+
+export function isCertificatesWelcomeDecisionPending(input: {
+  loadState: "loading" | "loaded" | "error";
+  itemsLength: number;
+  archived: boolean;
+  filtersActive: boolean;
+}): boolean {
+  if (input.loadState !== "loading") return false;
+  if (input.itemsLength > 0) return false;
+  if (input.archived) return false;
+  if (input.filtersActive) return false;
+  return true;
+}
+
+/** Initial overview list decision — not refetch while a prior successful list is ready. */
+export function isPartnersOverviewPresentationPending(input: {
+  loading: boolean;
+  listReady: boolean;
+  error: string;
+}): boolean {
+  if (input.error.trim()) return false;
+  if (input.listReady) return false;
+  if (input.loading) return true;
+  // Pre-first-response / unresolved without error payload (Hub starts loadingList true).
+  return true;
+}
+
+export function isScannerWelcomeDecisionPending(probe: ScannerEmptyActivityProbe): boolean {
+  return probe.status === "idle" || probe.status === "loading";
+}
+
+export function isTeamWelcomeDecisionPending(input: {
+  loading: boolean;
+  error: string;
+}): boolean {
+  return input.loading && !input.error.trim();
+}
+
+export function isRecommendationsWelcomeDecisionPending(input: {
+  loadState: "loading" | "loaded" | "error";
+  itemsLength: number;
+}): boolean {
+  return input.loadState === "loading" && input.itemsLength === 0;
+}
+
+export function isHomeMetricsPresentationPending(loadState: "loading" | "loaded"): boolean {
+  return loadState === "loading";
+}
