+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+
+const mockEnabled = vi.fn();
+const mockPilot = vi.fn();
+const mockCabinetUser = vi.fn();
+const mockSession = vi.fn();
+const mockProCtx = vi.fn();
+const mockAuth = vi.fn();
+const mockResolveSubjects = vi.fn();
+const mockBuildSubjects = vi.fn();
+const mockLoad = vi.fn();
+const mockAgentOnly = vi.fn();
+const mockApplyAgent = vi.fn();
+
+vi.mock('@/lib/profMiniAppConfig', () => ({
+  isProfMiniAppEnabled: () => mockEnabled(),
+  isProfMiniAppPilotOpenForUser: (...args: unknown[]) => mockPilot(...args),
+}));
+
+vi.mock('@/lib/miniAppCabinetAuth', () => ({
+  getProfCabinetUserForMiniApp: (...args: unknown[]) => mockCabinetUser(...args),
+}));
+
+vi.mock('@/lib/miniAppSessionCookie', () => ({
+  assertMiniAppAccess: (...args: unknown[]) => mockSession(...args),
+}));
+
+vi.mock('@/lib/proContextRequest', () => ({
+  getProContextForRequest: (...args: unknown[]) => mockProCtx(...args),
+}));
+
+vi.mock('@/lib/employeeWorkspace/access', () => ({
+  authorizeSettlementWalletRead: (...args: unknown[]) => mockAuth(...args),
+}));
+
+vi.mock('@/lib/proSettlements', () => ({
+  resolveSettlementSubjects: (...args: unknown[]) => mockResolveSubjects(...args),
+  buildOrgStaffSettlementSubjects: (...args: unknown[]) => mockBuildSubjects(...args),
+  loadSettlementResponse: (...args: unknown[]) => mockLoad(...args),
+}));
+
+vi.mock('@/lib/agentReceivables/agentR05IncomingOnly', () => ({
+  isAgentR05IncomingOnlyWallet: (...args: unknown[]) => mockAgentOnly(...args),
+  applyAgentR05IncomingOnlySettlementView: (d: unknown) => mockApplyAgent(d),
+}));
+
+describe('GET /api/pro/mini-app/wallet/settlements', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockEnabled.mockReturnValue(true);
+    mockPilot.mockReturnValue(true);
+    mockCabinetUser.mockResolvedValue({ id: 'u1', publicId: 'p1', role: 'PRO' });
+    mockSession.mockResolvedValue({ ok: true });
+    mockProCtx.mockResolvedValue({ role: 'SOLO_PARTNER' });
+    mockAuth.mockResolvedValue({
+      ok: true,
+      mode: 'personal',
+      branchScope: { ok: true, branchIds: [], mode: 'full_org' },
+      walletReadScope: 'personal',
+      companyLedgerFull: false,
+    });
+    mockResolveSubjects.mockResolvedValue({
+      receivableProUserIds: ['u1'],
+      receivableAgentUserIds: [],
+      payableStoreUserIds: ['u1'],
+    });
+    mockLoad.mockResolvedValue({
+      receivable: [{ id: 'r1', payoutActions: { canRecordCash: true, canRecordTransfer: false } }],
+      payable: [{ id: 'p1', payoutActions: { canRecordCash: true, canRecordTransfer: true } }],
+      completed: [],
+      coverageNote: 'note',
+    });
+    mockAgentOnly.mockResolvedValue(false);
+    mockApplyAgent.mockImplementation((d: { receivable: unknown[] }) => d);
+  });
+
+  it('returns 404 when pilot is off', async () => {
+    mockEnabled.mockReturnValue(false);
+    const { GET } = await import('../wallet/settlements/route');
+    const res = await GET(
+      new NextRequest('https://x/api/pro/mini-app/wallet/settlements?host=telegram', {
+        headers: { 'x-remcard-mini-app-platform': 'telegram' },
+      }),
+    );
+    expect(res.status).toBe(404);
+  });
+
+  it('strips payout action tokens', async () => {
+    const { GET } = await import('../wallet/settlements/route');
+    const res = await GET(
+      new NextRequest('https://x/api/pro/mini-app/wallet/settlements?host=max', {
+        headers: { 'x-remcard-mini-app-platform': 'max' },
+      }),
+    );
+    expect(res.status).toBe(200);
+    const json = await res.json();
+    expect(json.receivable[0]?.payoutActions).toBeUndefined();
+    expect(json.payable[0]?.payoutActions).toBeUndefined();
+    expect(json.walletReadScope).toBe('personal');
+    expect(mockAuth).toHaveBeenCalledWith(
+      expect.objectContaining({
+        explicitQueryBranchId: null,
+        contextBranchId: null,
+      }),
+    );
+  });
+
+  it('forwards explicit branchId to read auth', async () => {
+    const { GET } = await import('../wallet/settlements/route');
+    await GET(
+      new NextRequest('https://x/api/pro/mini-app/wallet/settlements?host=telegram&branchId=b1', {
+        headers: { 'x-remcard-mini-app-platform': 'telegram' },
+      }),
+    );
+    expect(mockAuth).toHaveBeenCalledWith(
+      expect.objectContaining({ explicitQueryBranchId: 'b1', contextBranchId: null }),
+    );
+  });
+
+  it('agent r05 incoming-only clears payables', async () => {
+    mockAgentOnly.mockResolvedValue(true);
+    mockApplyAgent.mockImplementation((d) => ({
+      ...d,
+      payable: [],
+      receivable: (d as { receivable: unknown[] }).receivable.map((r) => ({
+        ...(r as object),
+        payoutActions: undefined,
+      })),
+    }));
+    const { GET } = await import('../wallet/settlements/route');
+    const res = await GET(
+      new NextRequest('https://x/api/pro/mini-app/wallet/settlements?host=telegram', {
+        headers: { 'x-remcard-mini-app-platform': 'telegram' },
+      }),
+    );
+    expect(res.status).toBe(200);
+    const json = await res.json();
+    expect(json.payable).toEqual([]);
+  });
+});
