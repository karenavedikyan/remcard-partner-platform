+import { describe, expect, it, vi, beforeEach } from 'vitest';
+import { loadMiniAppWalletSettlements } from '@/lib/miniAppWalletSettlements';
+import { NextRequest } from 'next/server';
+
+const mockUser = vi.fn();
+const mockProContext = vi.fn();
+const mockAuth = vi.fn();
+const mockLoad = vi.fn();
+
+vi.mock('@/lib/proAuth', () => ({ getAuthenticatedUser: (...a: unknown[]) => mockUser(...a) }));
+vi.mock('@/lib/proContextRequest', () => ({
+  getProContextForRequest: (...a: unknown[]) => mockProContext(...a),
+  preferredBranchIdFromRequest: () => null,
+}));
+vi.mock('@/lib/settlementWalletReadAuth', () => ({
+  authorizeSettlementWalletRead: (...a: unknown[]) => mockAuth(...a),
+}));
+vi.mock('@/lib/proWalletSettlements', () => ({
+  loadProWalletSettlements: (...a: unknown[]) => mockLoad(...a),
+}));
+vi.mock('@/lib/agentR05IncomingOnly', () => ({
+  applyAgentR05IncomingOnlySettlements: (body: unknown) => body,
+}));
+vi.mock('@/lib/agentR05Gate', () => ({ isProfR05AgentReceivablesEnabled: () => false }));
+
+describe('loadMiniAppWalletSettlements', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockUser.mockResolvedValue({ id: 'u1', role: 'PRO' });
+    mockProContext.mockResolvedValue({ role: 'SOLO_PARTNER' });
+    mockAuth.mockReturnValue({ allowed: true, mode: 'pro-solo' });
+    mockLoad.mockResolvedValue({
+      receivable: [
+        {
+          id: 'r1',
+          payoutActions: { canRecordCash: true, canRecordTransfer: false },
+        },
+      ],
+      payable: [],
+      completed: [],
+      coverageNote: '',
+    });
+  });
+
+  it('strips payout action tokens for mini-app read', async () => {
+    const req = new NextRequest('https://x/api/pro/mini-app/wallet/settlements');
+    const out = await loadMiniAppWalletSettlements({ req, userId: 'u1', branchId: null });
+    expect(out.status).toBe('ok');
+    if (out.status === 'ok') {
+      expect(out.body.receivable[0]?.payoutActions).toBeUndefined();
+    }
+  });
+
+  it('denies when authorizeSettlementWalletRead fails', async () => {
+    mockAuth.mockReturnValue({ allowed: false, reason: 'missing_wallet_permission' });
+    const req = new NextRequest('https://x/api/pro/mini-app/wallet/settlements');
+    const out = await loadMiniAppWalletSettlements({ req, userId: 'u1', branchId: null });
+    expect(out.status).toBe('forbidden');
+  });
+});