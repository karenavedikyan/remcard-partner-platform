+import { NextRequest, NextResponse } from 'next/server';
+import { apiError } from '@/lib/api/error';
+import { authorizeSettlementWalletRead } from '@/lib/employeeWorkspace/access';
+import {
+  applyAgentR05IncomingOnlySettlementView,
+  isAgentR05IncomingOnlyWallet,
+} from '@/lib/agentReceivables/agentR05IncomingOnly';
+import { getProContextForRequest } from '@/lib/proContextRequest';
+import {
+  buildOrgStaffSettlementSubjects,
+  loadSettlementResponse,
+  resolveSettlementSubjects,
+} from '@/lib/proSettlements';
+import { isProfMiniAppEnabled, isProfMiniAppPilotOpenForUser } from '@/lib/profMiniAppConfig';
+import { assertMiniAppAccess } from '@/lib/miniAppSessionCookie';
+import { getProfCabinetUserForMiniApp } from '@/lib/miniAppCabinetAuth';
+import { miniAppApiDynamic } from '@/lib/miniAppRouteSegment';
+
+export const dynamic = miniAppApiDynamic.dynamic;
+export const fetchCache = miniAppApiDynamic.fetchCache;
+export const revalidate = miniAppApiDynamic.revalidate;
+
+function parseHostPlatform(raw: string | null): 'telegram' | 'max' | null {
+  const v = raw?.trim().toLowerCase();
+  if (v === 'telegram' || v === 'tg') return 'telegram';
+  if (v === 'max') return 'max';
+  return null;
+}
+
+/** Read-only mini-app alias of GET /api/pro/wallet/settlements — no payout action tokens. */
+export async function GET(req: NextRequest) {
+  if (!isProfMiniAppEnabled()) {
+    return apiError('NOT_FOUND');
+  }
+
+  const platform =
+    parseHostPlatform(req.headers.get('x-remcard-mini-app-platform')) ??
+    parseHostPlatform(req.nextUrl.searchParams.get('host'));
+  if (!platform) {
+    return apiError('BAD_REQUEST', 'Укажите платформу хоста');
+  }
+
+  const user = await getProfCabinetUserForMiniApp(req, platform);
+  if (!user) return apiError('UNAUTHORIZED');
+
+  if (!isProfMiniAppPilotOpenForUser({ userId: user.id, publicId: user.publicId })) {
+    return apiError('NOT_FOUND');
+  }
+
+  const sessionGuard = await assertMiniAppAccess(req, platform, user.id);
+  if (!sessionGuard.ok) {
+    return NextResponse.json(
+      { error: sessionGuard.message, code: sessionGuard.code },
+      { status: sessionGuard.status },
+    );
+  }
+
+  const proCtx = await getProContextForRequest(req, user.id);
+  const explicitQueryBranchId = req.nextUrl.searchParams.get('branchId')?.trim() || null;
+  const readAuth = await authorizeSettlementWalletRead({
+    user,
+    proCtx,
+    explicitQueryBranchId,
+    /** Mini-app scopes ledger only via explicit `?branchId=` from the picker — not PROF branch cookies. */
+    contextBranchId: null,
+  });
+  if (!readAuth.ok) {
+    return NextResponse.json({ error: readAuth.error }, { status: readAuth.status });
+  }
+
+  let subjects: Awaited<ReturnType<typeof resolveSettlementSubjects>> | null = null;
+  if (readAuth.mode === 'org_staff' && readAuth.orgOwnerId && readAuth.branchScope.ok) {
+    subjects = buildOrgStaffSettlementSubjects({
+      orgOwnerId: readAuth.orgOwnerId,
+      branchIds: readAuth.branchScope.branchIds,
+      companyLedgerFull: readAuth.companyLedgerFull,
+    });
+  } else if (readAuth.mode === 'owner' || readAuth.mode === 'personal') {
+    subjects = await resolveSettlementSubjects(user.id);
+  } else {
+    return NextResponse.json({ error: 'Forbidden' }, { status: 403 });
+  }
+
+  if (!subjects) {
+    return NextResponse.json({ error: 'Not found' }, { status: 404 });
+  }
+
+  let data = await loadSettlementResponse(subjects);
+  const walletReadScope = readAuth.walletReadScope;
+
+  if (await isAgentR05IncomingOnlyWallet(user.id)) {
+    data = applyAgentR05IncomingOnlySettlementView(data);
+    const res = NextResponse.json({
+      receivable: data.receivable,
+      payable: [],
+      completed: data.completed,
+      coverageNote: data.coverageNote,
+      walletReadScope,
+    });
+    res.headers.set('Cache-Control', 'private, no-store');
+    return res;
+  }
+
+  const receivable = data.receivable.map((row) => ({ ...row, payoutActions: undefined }));
+  const payable = data.payable.map((row) => ({ ...row, payoutActions: undefined }));
+  const completed = data.completed.map((row) => ({ ...row, payoutActions: undefined }));
+
+  const res = NextResponse.json({
+    receivable,
+    payable,
+    completed,
+    coverageNote: data.coverageNote,
+    walletReadScope,
+  });
+  res.headers.set('Cache-Control', 'private, no-store');
+  return res;
+}
